# API 설정 파일
# .gitignore에 추가되어 있어 Git에 커밋되지 않습니다

# DART API 키 (금융감독원 전자공시)
# 발급: https://opendart.fss.or.kr/
# 무료 API 키를 발급받아 아래에 입력하세요
DART_API_KEY=

# FRED API 키 (Federal Reserve Economic Data)
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ECOS API 키 (한국은행 경제통계)
# 발급: https://ecos.bok.or.kr/api/#/
ECOS_API_KEY=

# 예시:
# DART_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ECOS_API_KEY=XXXXXXXXXXXXXXXXXXXX
